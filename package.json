{
  "name": "@vaneui/md",
  "version": "1.3.0",
  "description": "Markdown renderer for React that outputs VaneUI components. Built on Markdoc, with frontmatter and fences that embed real components.",
  "author": "",
  "license": "MIT",
  "homepage": "https://vaneui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneui/md.git"
  },
  "bugs": {
    "url": "https://github.com/vaneui/md/issues"
  },
  "keywords": [
    "react",
    "markdown",
    "markdoc",
    "markdown-renderer",
    "md",
    "vane",
    "vaneui",
    "typescript",
    "component"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.esm.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./yaml": {
      "import": {
        "types": "./dist/yaml.d.mts",
        "default": "./dist/yaml.esm.js"
      },
      "require": {
        "types": "./dist/yaml.d.cts",
        "default": "./dist/yaml.cjs"
      }
    },
    "./registry": {
      "import": {
        "types": "./dist/registry.d.mts",
        "default": "./dist/registry.esm.js"
      },
      "require": {
        "types": "./dist/registry.d.cts",
        "default": "./dist/registry.cjs"
      }
    },
    "./spec": {
      "import": {
        "types": "./dist/spec.d.mts",
        "default": "./dist/spec.esm.js"
      },
      "require": {
        "types": "./dist/spec.d.cts",
        "default": "./dist/spec.cjs"
      }
    },
    "./include": {
      "import": {
        "types": "./dist/include.d.mts",
        "default": "./dist/include.esm.js"
      },
      "require": {
        "types": "./dist/include.d.cts",
        "default": "./dist/include.cjs"
      }
    },
    "./shiki": {
      "import": {
        "types": "./dist/shiki.d.mts",
        "default": "./dist/shiki.esm.js"
      },
      "require": {
        "types": "./dist/shiki.d.cts",
        "default": "./dist/shiki.cjs"
      }
    },
    "./prism": {
      "import": {
        "types": "./dist/prism.d.mts",
        "default": "./dist/prism.esm.js"
      },
      "require": {
        "types": "./dist/prism.d.cts",
        "default": "./dist/prism.cjs"
      }
    },
    "./styles": "./dist/styles/index.css"
  },
  "scripts": {
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "build:js": "npm run type-check && npm run clean && rollup -c --bundleConfigAsCjs",
    "build:css": "postcss src/styles/index.css -o dist/styles/index.css --no-map",
    "build:types": "node scripts/generate-dual-types.mjs",
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:css && node scripts/check-dist.mjs",
    "test": "npm run type-check && node node_modules/jest/bin/jest.js",
    "check:package": "publint run --strict && attw --pack .",
    "playground:install": "cd playground && npm install",
    "playground:dev": "cd playground && npm run dev",
    "playground": "npm run playground:install && npm run playground:dev"
  },
  "peerDependencies": {
    "@vaneui/ui": "^1.5.0",
    "prism-react-renderer": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "shiki": "^3.0.0 || ^4.0.0",
    "yaml": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "prism-react-renderer": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.5.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vaneui/ui": "^1.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "jsdom": "^26.1.0",
    "markdoc-0.5.10": "npm:@markdoc/markdoc@0.5.10",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "prism-react-renderer": "^2.4.1",
    "publint": "0.3.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.9",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "shiki": "^4.3.1",
    "ts-jest": "^29.3.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "yaml": "^2.8.3"
  }
}
